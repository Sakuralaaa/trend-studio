POSTGRES_PASSWORD=REPLACE_RANDOM_COLLECTOR_PASSWORD
REDIS_PASSWORD=REPLACE_RANDOM_COLLECTOR_REDIS_PASSWORD
DTK_SECRET_KEY=REPLACE_RANDOM_AT_LEAST_32_CHARACTERS
DTK_DATABASE_URL=postgresql+asyncpg://dtk:REPLACE_RANDOM_COLLECTOR_PASSWORD@postgres:5432/dtk
DTK_REDIS_URL=redis://:REPLACE_RANDOM_COLLECTOR_REDIS_PASSWORD@redis:6379/0
DTK_LOG_LEVEL=info
DTK_LOG_JSON=true
DTK_BROWSER_RPC_URL=
DTK_DOWNLOADER_URL=
DTK_BACKUP_DIR=/var/lib/dtk/backups
